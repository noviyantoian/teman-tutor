# ===========================================
# Teman Tutor — Environment Variables Example
# Copy this file to .env.local and fill values.
# NEVER commit .env.local or .env.production!
# ===========================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://temantutor.id
NEXT_PUBLIC_SITE_NAME="Teman Tutor"

# --- WhatsApp ---
# Format internasional tanpa + dan tanpa spasi, contoh: 6281234567890
NEXT_PUBLIC_WA_NUMBER=6281234567890
NEXT_PUBLIC_WA_DEFAULT_MESSAGE="Halo Teman Tutor, saya ingin konsultasi gratis untuk les privat anak saya."

# --- Email transactional (Resend) ---
# Dapatkan key di https://resend.com — JANGAN ekspos sebagai NEXT_PUBLIC_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=admin@temantutor.id
LEAD_FROM_EMAIL="Teman Tutor <noreply@temantutor.id>"

# --- Analytics (opsional di dev, wajib di production) ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# --- Security ---
# Rahasia untuk signing/anti-CSRF — generate dengan: openssl rand -base64 32
APP_SECRET=replace_with_random_32_byte_base64

# --- Rate limit (per IP, per menit) ---
RATE_LIMIT_LEAD_PER_HOUR=5
