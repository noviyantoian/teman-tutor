{
  "name": "teman-tutor-web",
  "version": "0.1.0",
  "private": true,
  "description": "Teman Tutor — Marketing website (Next.js 16, Tailwind, shadcn/ui)",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "NEXT_USE_WEBPACK=true next dev",
    "build": "next build",
    "build:webpack": "NEXT_USE_WEBPACK=true next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "analyze": "ANALYZE=true next build",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.4",
    "class-variance-authority": "0.7.0",
    "lucide-react": "0.453.0",
    "framer-motion": "12.9.4",
    "zod": "3.23.8",
    "resend": "4.8.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-checkbox": "1.3.3"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tailwindcss": "3.4.13",
    "postcss": "8.4.47",
    "autoprefixer": "10.4.20",
    "tailwindcss-animate": "1.0.7",
    "eslint": "9.12.0",
    "eslint-config-next": "16.2.6",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "@next/bundle-analyzer": "16.2.6"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.1"
}
